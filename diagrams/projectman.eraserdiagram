user [icon: user, color: blue] {
    id int pk
    firebaseUid string unique
    email string
    name string
    role string
    createdAt Date
    updatedAt Date
}

client [icon: client] {
    id int pk
    name string
    address string
    vat_no string
    email string
    notes string
}

currency [icon: client] {
    id      Int
    code    String
    name    String
}

staff [icon: worker] {
    id int pk
    first_name string
    last_name string
    birth_date timestamp
    position string
    user_id int
}
staff.user_id <> user.id

location [icon: worker] {
    id int pk
    location_name string
    latitude string
    longitude string
    notes string
}

material_groups [icon: worker] {
    id string pipeline
    name string
    description string
}

material_names [icon: worker] {
    id int pk
    name string unique
    dn string
    pn string
    degree string
    description string
    type_id int
}
material_names.type_id <> material_types.id

material_types [icon: worker] {
    id string
    type unique string
    group_id int
}
material_types.group_id <> material_groups.id


project [icon: worker] {
    id int pk
    full_name string
    display_name string
    client_id int
    manager_id nullable int
    status string
    notes string
    start_date timestamp
    end_date timestamp
    currency_id id
    boqStructureType string
    created_at timestamp
    updated_at timestamp
    user_id int
}
project.user_id <> user.id
project.client_id > client.id
project.manager_id > staff.id
project.currency_id > currency.id

project_section [icon: worker] {
  id int pk
  project_id int
  section_code string
  section_name string
  section_type string
  total_amount decimal
  location_id int
  created_at timestamp
  updated_at timestamp
  user_id int
}
project_section.project_id <> project.id
project_section.location_id <> location.id

project_section_breakdown {
  id int
  section_id int
  breakdown_id int
}
project_section_breakdown.section_id - project_section.id
project_section_breakdown.breakdown_id - boq_breakdown.id

project_boq_config {
  id int
  project_id int
  numbering_system string
  currency_code string
  decimal_places int
  section_types json
  custom_fields json
  created_at timestamp
  updated_at timestamp
  user_id int
}
project_boq_config.project_id > project.id

boq_breakdown {
  id int
  code string
  name string
  description string
  created_at timestamp
  updated_at timestamp
  user_id int  
}

boq_item {
  id int
  section_id int
  breakdown_id int
  item_number int
  description string
  material_id int
  unit_id int
  quantity decimal
  unit_price decimal
  total_price decimal
  parent_item_id int
  level int
  item_type string
  created_at timestamp
  updated_at timestamp
  user_id int
}
boq_item.id <> project_section.id
boq_breakdown.id <> boq_item.breackdown_id
boq_item.material_id <> material_names.id
boq_item.parent_item_id > boq_item.id

progress [icon: worker] {
    id int pk
    project_id int
    team_id nullable int
    task_id int
    build_quantity number
    start_date nullable timestamp
    end_date nullable timestamp
    notes string
    milestone_id nullable int // IPC(interim payment certificate) for example
    created_at timestamp
    updated_at timestamp
    user_id int
}
progress.user_id <> user.id
progress.team_id <> team.id
progress.task_id > task.id
progress.milestone_id > milestone.id

milestone [icon: worker] {
    id int pk
    project_id int
    identifier string
    description string
    status string // pending, approved, rejected
    payment nullable number
    created_at timestamp
    updated_at timestamp
    user_id int
}
milestone.currency_id > currency.id

task [icon: worker] {
    id int pk
    task_name unique string
    task_group string  // node, reservoir, pipeline, prv, washout, manhole, hydrant, road, general
    status nullable string // in-progress, complete (use ENUM for db)
    projected_quantity number
    unit_id int
    location_id nullable string
    drawing_ref string
    notes string
    project_id int
    created_at timestamp
    updated_at timestamp
    user_id int
}
task.unit_id > unit.id
task.location_id > location.id
task.project_id > project.id

task_materials [icon: worker] {
    id int pk
    task_id int
    material_id int
    quantity number
    unit_id int
    notes string
    created_at timestamp
    updated_at timestamp
    user_id int
}
task_materials.task_id > task.id
task_materials.unit_id > unit.id

team [icon: worker] {
    id int pk
    team_name unique string
    company_name string
    vat_no string
    address string
    email string
    created_at timestamp
    updated_at timestamp
    user_id int
}

unit [icon: worker] {
    id int pk
    unit unique string
}