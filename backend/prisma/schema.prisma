// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ========================================
// PROJECT MANAGEMENT
// ========================================
model BoqBreakdown {
  id          Int                       @id @default(autoincrement())
  code        String                    @unique // BoQ sheet name/code e.g., 'WS01', 'WW01', 'WSSP', etc.
  name        String
  description String?
  boqItems    BoqItem[]
  sections    ProjectSectionBreakdown[]
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  user        User                      @relation(fields: [userId], references: [id])
  userId      Int                       @map("user_id")

  @@map("boq_breakdown")
}

model BoqItem {
  id           Int             @id @default(autoincrement())
  sectionId    Int?            @map("section_id")
  section      ProjectSection? @relation(fields: [sectionId], references: [id])
  breakdownId  Int?            @map("breakdown_id")
  breakdown    BoqBreakdown?   @relation(fields: [breakdownId], references: [id])
  itemNumber   String          @map("item_number") @db.VarChar(20) // e.g., "1.1", "2.3"
  description  String
  materialId   Int?            @map("material_id")
  material     MaterialName?   @relation(fields: [materialId], references: [id])
  unitId       Int?            @map("unit_id")
  unit         Unit?           @relation(fields: [unitId], references: [id])
  quantity     Decimal?        @db.Decimal(12, 4)
  unitPrice    Decimal?        @map("unit_price") @db.Decimal(12, 2)
  totalPrice   Decimal?        @map("total_price") @db.Decimal(15, 2)
  parentItemId Int?            @map("parent_item_id")
  parentItem   BoqItem?        @relation("Itemhierarchy", fields: [parentItemId], references: [id])
  childItems   BoqItem[]       @relation("Itemhierarchy")
  level        Int?            @default(0) // e.g., 0 for main items, 1 for sub-items
  itemType     String?         @map("item_type") // e.g. 'material', 'labor', 'equipment', 'other'
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  userId       Int             @map("user_id")
  user         User            @relation(fields: [userId], references: [id])

  @@map("boq_item")
}

model Client {
  id        Int       @id @default(autoincrement())
  name      String
  address   String
  vatNo     String    @map("vat_no")
  email     String
  notes     String
  createdAt DateTime  @default(now()) @map("created_at")
  Project   Project[]

  @@map("client")
}

model Location {
  id             Int              @id @default(autoincrement())
  locationName   String           @map("location_name")
  latitude       Float
  longitude      Float
  notes          String
  Task           Task[]
  ProjectSection ProjectSection[]

  @@map("location")
}

enum MilestoneStatus {
  pending
  approved
  rejected
}

model Milestone {
  id           Int             @id @default(autoincrement())
  project_id   Int
  identifier   String
  description  String
  approvalDate DateTime?       @map("approval_date")
  status       MilestoneStatus
  payment      Decimal?
  Progress     Progress[]
  Currency     Currency?       @relation(fields: [currencyId], references: [id])
  currencyId   Int?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  user         User            @relation(fields: [userId], references: [id])
  userId       Int             @map("user_id")

  @@map("milestone")
}

model Progress {
  id            Int       @id @default(autoincrement())
  project       Project   @relation(fields: [projectId], references: [id])
  projectId     Int       @map("project_id")
  teamId        Int?      @map("team_id")
  task          Task      @relation(fields: [taskId], references: [id])
  taskId        Int       @map("task_id")
  buildQuantity Decimal   @map("build_quantity")
  startDate     DateTime  @map("start_date")
  endDate       DateTime  @map("end_date")
  notes         String
  milestone     Milestone @relation(fields: [milestoneId], references: [id])
  milestoneId   Int       @map("milestone_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  user          User      @relation(fields: [userId], references: [id])
  userId        Int       @map("user_id")

  @@map("progress")
}

enum ProjectStatus {
  active
  completed
  inProgress
  onHold
}

enum boqStructureType {
  hierarchical
  sequential
  alphanumeric
}

model Project {
  id               Int                @id @default(autoincrement())
  fullName         String             @map("full_name")
  displayName      String             @map("display_name")
  client           Client?            @relation(fields: [clientId], references: [id])
  clientId         Int?               @map("client_id")
  managerId        Int?               @map("manager_id")
  status           ProjectStatus
  notes            String
  startDate        DateTime           @map("start_date")
  endDate          DateTime           @map("end_date")
  currency         Currency           @relation(fields: [currencyId], references: [id])
  currencyId       Int
  boqStructureType boqStructureType   @default(hierarchical) @map("boq_structure_type") // e.g. 'hierarchical', 'sequential', 'alphanumeric'
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id])
  userId           Int                @map("user_id")
  Progress         Progress[]
  Task             Task[]
  ProjectSection   ProjectSection[]
  projectBoqConfig ProjectBoqConfig[]

  @@map("project")
}

model ProjectBoqConfig {
  id              Int      @id @default(autoincrement())
  project         Project  @relation(fields: [projectId], references: [id])
  projectId       Int      @map("project_id")
  numberingSystem String   @default("hierarchical") @map("numbering_system") @db.VarChar(50) // e.g. 'hierarchical', 'sequential', 'alphanumeric'
  currencyCode    String?  @map("currency_code") @db.VarChar(3)
  decimalPlaces   Int?     @default(2) @map("decimal_places")
  sectionTypes    Json?    @map("section_types") // Store allowed section types as 'water_supply', 'sanitation', etc. 
  customFields    Json?    @map("custom_fields") // Project-specific additional fields
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("project_boq_config")
}

model ProjectSection {
  id          Int                       @id @default(autoincrement())
  projectId   Int
  project     Project                   @relation(fields: [projectId], references: [id])
  sectionCode String                    @map("section_code") // sheet names 'WS01', 'WW01', 'WSSP', etc.
  sectionName String                    @map("section_name")
  sectionType String                    @map("section_type") // list item from summary 'water_supply', 'sanitation', 'spare_parts', 'dayworks', 'provisional'
  totalAmount Decimal?                  @map("total_amount") @db.Decimal(15, 2)
  locationId  Int?                      @map("location_id")
  location    Location?                 @relation(fields: [locationId], references: [id])
  boqItems    BoqItem[]
  breakdowns  ProjectSectionBreakdown[]
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  user        User                      @relation(fields: [userId], references: [id])
  userId      Int                       @map("user_id")
  Currency    Currency?                 @relation(fields: [currencyId], references: [id])
  currencyId  Int?

  @@map("project_sections")
}

model ProjectSectionBreakdown {
  id          Int            @id @default(autoincrement())
  section     ProjectSection @relation(fields: [sectionId], references: [id])
  sectionId   Int            @map("section_id")
  breakdown   BoqBreakdown   @relation(fields: [breakdownId], references: [id])
  breakdownId Int            @map("breakdown_id")

  @@unique([sectionId, breakdownId])
  @@map("project_section_breakdown")
}

enum TaskGroup {
  node
  reservoir
  pipeline
  prv
  washout
  hydrant
  road
  general
}

enum TaskStatus {
  in_progress
  complete
}

model Task {
  id                Int            @id @default(autoincrement())
  taskName          String         @map("task_name")
  taskGroup         TaskGroup
  status            TaskStatus?
  projectedQuantity Decimal        @map("projected_quantity")
  unit              Unit           @relation(fields: [unitId], references: [id])
  unitId            Int            @map("unit_id")
  location          Location       @relation(fields: [locationId], references: [id])
  locationId        Int            @map("location_id")
  drawing_ref       String
  notes             String
  project           Project        @relation(fields: [projectId], references: [id])
  projectId         Int            @map("project_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  user              User           @relation(fields: [userId], references: [id])
  userId            Int            @map("user_id")
  Progress          Progress[]
  TaskMaterial      TaskMaterial[]

  @@map("task")
}

model TaskMaterial {
  id         Int          @id @default(autoincrement())
  task       Task         @relation(fields: [taskId], references: [id])
  taskId     Int          @map("task_id")
  material   MaterialName @relation(fields: [materialId], references: [id])
  materialId Int          @map("material_id")

  @@map("task_material")
}

// ========================================
// SHIPMENT MANAGEMENT
// ========================================
model Freight {
  id          Int              @id @default(autoincrement())
  truckNumber String           @map("truck_number")
  forwarder   String?
  billNumber  String?          @map("bill_number")
  billDate    DateTime?        @map("bill_date")
  freightRate Decimal?         @map("freight_rate") @db.Decimal(15, 2)
  currency    Currency?        @relation(fields: [currencyId], references: [id])
  currencyId  Int?             @map("currency_id")
  shipment    Shipment         @relation(fields: [shipmentId], references: [id])
  shipmentId  Int              @map("shipment_id")
  invoices    FreightInvoice[]
  user        User             @relation(fields: [userId], references: [id])
  userId      Int              @map("user_id")

  @@map("freight")
}

model FreightInvoice {
  freight   Freight @relation(fields: [freightId], references: [id])
  freightId Int     @map("freight_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  invoiceId Int     @map("invoice_id")

  @@id([freightId, invoiceId])
  @@map("freight_invoice")
}

model Invoice {
  id            Int              @id @default(autoincrement())
  vendor        Vendor           @relation(fields: [vendorId], references: [id])
  vendorId      Int              @map("vendor_id")
  invoiceNumber String           @map("invoice_number")
  invoiceDate   DateTime         @map("invoice_date")
  totalAmount   Decimal          @map("total_amount") @db.Decimal(15, 2)
  isArrived     Boolean?         @default(false) @map("is_arrived")
  currency      Currency         @relation(fields: [currencyId], references: [id])
  currencyId    Int              @map("currency_id")
  shipment      Shipment         @relation(fields: [shipmentId], references: [id])
  shipmentId    Int              @map("shipment_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  user          User             @relation(fields: [userId], references: [id])
  userId        Int              @map("user_id")
  Items         InvoiceItem[]
  Freights      FreightInvoice[]

  @@map("invoice")
}

model InvoiceItem {
  id          Int          @id @default(autoincrement())
  invoice     Invoice      @relation(fields: [invoiceId], references: [id])
  invoiceId   Int
  product     MaterialName @relation(fields: [productId], references: [id])
  productId   Int          @map("product_id")
  description String
  quantity    Decimal
  unit        Unit         @relation(fields: [unitId], references: [id])
  unitId      Int
  unitPrice   Decimal      @map("unit_price") @db.Decimal(15, 2)
  total       Decimal      @map("total") @db.Decimal(15, 2)

  @@map("invoice_item")
}

enum ShipmentStatus {
  APPLIED
  DECLARED
  ARRIVED
}

model Shipment {
  id                 Int            @id @default(autoincrement())
  alias              String         @unique
  status             ShipmentStatus
  declaration_number String?        @map("declaration_number")
  declaration_date   DateTime?      @map("declaration_date")
  user               User           @relation(fields: [userId], references: [id])
  userId             Int            @map("user_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  Files              ShipmentFile[]
  Freights           Freight[]
  Invoices           Invoice[]

  @@map("shipment")
}

model ShipmentFile {
  id         Int      @id @default(autoincrement())
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  shipmentId Int      @map("shipment_id")
  fileName   String   @map("file_name")
  fileType   String?  @map("file_type")
  fileData   Bytes?   @map("file_data")

  @@map("shipment_file")
}

// ========================================
// SETTINGS
// ========================================
model Currency {
  id             Int              @id @default(autoincrement())
  code           String           @unique // e.g., "USD"
  name           String? // e.g., "United States Dollar"
  symbol         String? // e.g., "$"
  Invoice        Invoice[]
  Freight        Freight[]
  Milestone      Milestone[]
  Project        Project[]
  ProjectSection ProjectSection[]

  @@map("currency")
}

model MaterialGroup {
  id           Int            @id @default(autoincrement())
  name         String         @unique // e.g. 'Pipes', 'Fittings', 'valves', 'other'
  description  String
  MaterialType MaterialType[]

  @@map("material_group")
}

model MaterialType {
  id           Int            @id @default(autoincrement())
  type         String         @unique // e.g. PE100 PIPE, PE100 BEND, CI CROSS, other
  group        MaterialGroup  @relation(fields: [groupId], references: [id])
  groupId      Int            @map("group_id")
  MaterialName MaterialName[]

  @@map("material_type")
}

model MaterialName {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  dn           String
  pn           String
  degree       Int
  description  String
  type         MaterialType   @relation(fields: [typeId], references: [id])
  typeId       Int            @map("type_id")
  InvoiceItem  InvoiceItem[]
  TaskMaterial TaskMaterial[]
  boqItems     BoqItem[]

  @@map("material_name")
}

model Staff {
  id        Int    @id @default(autoincrement())
  firstName String @map("first_name")
  lastName  String @map("last_name")
  address   String
  phone     String
  email     String
  position  String
  user      User   @relation(fields: [userId], references: [id])
  userId    Int    @map("user_id")

  @@map("staff")
}

model Vendor {
  id        Int       @id @default(autoincrement())
  alias     String    @unique
  name      String
  address   String
  country   String
  user      User      @relation(fields: [userId], references: [id])
  userId    Int       @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  Invoice   Invoice[]

  @@map("vendor")
}

model Unit {
  id          Int           @id @default(autoincrement())
  unit        String        @unique
  InvoiceItem InvoiceItem[]
  Task        Task[]
  boqItems    BoqItem[]

  @@map("unit")
}

// ========================================
// USER MANAGEMENT
// ========================================
model User {
  id             Int              @id @default(autoincrement())
  firebaseUid    String           @unique
  email          String           @unique
  name           String?
  role           String           @default("user")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Vendor         Vendor[]
  Invoice        Invoice[]
  Shipment       Shipment[]
  Freight        Freight[]
  Project        Project[]
  Staff          Staff[]
  Progress       Progress[]
  Task           Task[]
  Milestone      Milestone[]
  ProjectSection ProjectSection[]
  boqItems       BoqItem[]
  BoqBreakdown   BoqBreakdown[]

  @@map("user")
}
