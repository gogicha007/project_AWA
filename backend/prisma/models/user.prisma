
model User {
  id          Int         @id @default(autoincrement())
  firebaseUid String      @unique
  email       String      @unique
  name        String?
  role        String      @default("user")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  Vendor      Vendor[]
  Invoice     Invoice[]
  Shipment    Shipment[]
  Freight     Freight[]
  Project     Project[]
  Staff       Staff[]
  Progress    Progress[]
  Task        Task[]
  Milestone   Milestone[]

  @@map("user")
}